{
	admin unix//run/caddy/admin.sock
	auto_https off
	servers {
		protocols h1
	}
	servers 127.0.0.1:8447 {
		name web
		protocols h1 h2
		listener_wrappers {
			# Only the Nginx UID can reach this listener (nftables).
			proxy_protocol {
				fallback_policy require
			}
			tls
		}
	}
}

(security_deny) {
	header {
		Permissions-Policy "accelerometer=(), ambient-light-sensor=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

(client_security) {
	header {
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "{args[0]}"
	}
}

(web_https) {
	bind 127.0.0.1
	import access_log
	tls /var/lib/acme/matrix.odarah.org/fullchain.pem /var/lib/acme/matrix.odarah.org/key.pem
	# Clear the previous 30-day HTTP/3 advertisement during the transition.
	header Alt-Svc clear
	header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
}

(upstream_response_timeout) {
	transport http {
		response_header_timeout {args[0]}
	}
}

(matrix_proxy) {
	header_up Host {http.request.host}
	header_up X-Forwarded-For {http.request.remote.host}
	header_up X-Forwarded-Proto https
	import upstream_response_timeout {args[0]}
}

(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 14
			roll_keep_for 336h
		}
	}
}

:80 {
	import access_log
	@known host odarah.org matrix.odarah.org cinny.matrix.odarah.org element.matrix.odarah.org guest.matrix.odarah.org rtc.matrix.odarah.org sable.matrix.odarah.org push.matrix.odarah.org dav.odarah.org xmpp.odarah.org conference.xmpp.odarah.org share.xmpp.odarah.org turn.odarah.org
	redir @known https://{host}{uri} 308
	respond 404
}

