			root * @ODARAH_LANDING_ROOT@
			header {
				Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
				Pragma "no-cache"
				Content-Security-Policy "@LANDING_CSP@"
			}
			file_server {
				precompressed br gzip
			}
		}
		respond 404
	}
}

https://matrix.odarah.org:8447 {
	import web_https
	import security_deny

	route {
		@root path /
		handle @root {
			root * @MATRIX_LANDING_ROOT@
			header {
				Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
				Pragma "no-cache"
				Content-Security-Policy "@LANDING_CSP@"
			}
			file_server {
				precompressed br gzip
			}
		}

		@client_well_known path /.well-known/matrix/client
		handle @client_well_known {
			header {
				Content-Type application/json
				Access-Control-Allow-Origin "*"
			}
			respond `{"m.homeserver":{"base_url":"https://matrix.odarah.org"},"org.matrix.msc4143.rtc_foci":[{"type":"livekit","livekit_service_url":"https://rtc.matrix.odarah.org"}]}` 200
		}

		@server_well_known path /.well-known/matrix/server
		handle @server_well_known {
			header Content-Type application/json
			respond `{"m.server":"matrix.odarah.org:443"}` 200
		}

		@support_well_known path /.well-known/matrix/support
		handle @support_well_known {
			header {
				Content-Type application/json
				Access-Control-Allow-Origin "*"
			}
			respond `{"contacts":[{"role":"m.role.admin","matrix_id":"@odara:matrix.odarah.org","email_address":"hostmaster@s3-odara.net"}]}` 200
		}

		@openid path /.well-known/openid-configuration
		handle @openid {
			reverse_proxy 10.77.3.14:8008 {
				import matrix_proxy 60s
			}
		}

		@oidc_css path /_tuwunel/oidc/account.css
		handle @oidc_css {
			header Cache-Control no-cache
			rewrite * /tuwunel-oidc.css
			root * @OIDC_ROOT@
			file_server
		}

		@matrix_upload path_regexp ^/_matrix/media/(?:r0|v3|unstable/fi[.]mau[.]msc2246)/upload(?:/[^/]+/[^/]+)?$
		handle @matrix_upload {
			request_body {
				max_size 1073741824
			}
			reverse_proxy 10.77.3.14:8008 {
				import matrix_proxy 60s
			}
		}

		rate_limit {
			zone matrix_login_ip {
				match {
					path_regexp ^/(?:_matrix/client/(?:r0|v[0-9]+|unstable)/login|_tuwunel/oidc/native)$
				}
				key {http.request.remote.host}
				events 1
				window 1s
			}
			zone matrix_login_global {
				match {
					path_regexp ^/(?:_matrix/client/(?:r0|v[0-9]+|unstable)/login|_tuwunel/oidc/native)$
				}
				key global
				events 10
				window 1s
			}
		}

		@matrix_api path_regexp ^/(?:_matrix|_tuwunel)/
		# Tuwunel can long-poll for up to 90s; allow time to build the response.
		@matrix_sync {
			method GET
			path /_matrix/client/r0/sync /_matrix/client/v3/sync
		}
		@sliding_sync {
			method POST
			path /_matrix/client/unstable/org.matrix.simplified_msc3575/sync
		}
		handle @matrix_api {
			request_body {
				max_size 16777216
			}
			reverse_proxy @matrix_sync 10.77.3.14:8008 {
				import matrix_proxy 120s
			}
			reverse_proxy @sliding_sync 10.77.3.14:8008 {
				import matrix_proxy 120s
			}
			reverse_proxy 10.77.3.14:8008 {
				import matrix_proxy 60s
			}
		}
		respond 404
	}
}

