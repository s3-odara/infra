			method POST
			path /_matrix/push/v1/notify
		}
		handle @push_allowed {
			rate_limit {
				zone sygnal_push_ip {
					match {
						method POST
						path /_matrix/push/v1/notify
					}
					key {http.request.remote.host}
					events 10
					window 1s
				}
				zone sygnal_push_global {
					match {
						method POST
						path /_matrix/push/v1/notify
					}
					key sygnal
					events 50
					window 1s
				}
			}
			request_body {
				max_size 1048576
			}
			reverse_proxy 10.77.3.16:5000 {
				import upstream_response_timeout 60s
				header_up Host {http.request.host}
				header_up X-Forwarded-For {http.request.remote.host}
				header_up X-Forwarded-Proto https
			}
		}
		respond 404
	}
}

